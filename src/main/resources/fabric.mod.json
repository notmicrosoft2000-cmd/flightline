{
  "schemaVersion": 1,
  "id": "flightline",
  "version": "${version}",
  "name": "Flight Line",
  "icon": "assets/flightline/icon.png",
  "description": "Flight physics and aircraft systems for the player: flight, GPWS/EGPWS, TCAS, cockpit alarms and radio.",
  "authors": [
    "Flight Line Crew"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.flightline.FlightLine"
    ],
    "client": [
      "dev.flightline.client.FlightLineClient"
    ]
  },
  "mixins": [
    {
      "config": "flightline.mixins.json"
    },
    {
      "config": "flightline.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
